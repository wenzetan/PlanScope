---
import { href } from "../lib/base.js";
import { data } from "../lib/data.js";
import { t } from "../i18n/index.js";
import T from "../components/T.astro";
import "../styles/global.css";

const NAV = [
  ["", "nav.overview"],
  ["providers/", "nav.providers"],
  ["plans/", "nav.plans"],
  ["models/", "nav.models"],
  ["pricing/", "nav.pricing"],
  ["privacy/", "nav.privacy"],
  ["reliability/", "nav.reliability"],
  ["changes/", "nav.changes"],
  ["sources/", "nav.sources"],
  ["methodology/", "nav.methodology"],
];

// `titleKey` looks up a localized <title>; `titleText` is used verbatim for
// records whose name is data (e.g. a provider name).
const { titleKey = "overview", titleText = null, current = "" } = Astro.props;
const docTitleKey = `docTitle.${titleKey}`;
const docTitleZh = titleText ? `${titleText} · PlanScope` : t("zh", docTitleKey);
const generated = data.generated_at ? data.generated_at.slice(0, 19).replace("T", " ") : "—";
---
<!doctype html>
<html lang="zh-CN" data-lang="zh" data-currency="cny">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="PlanScope — AI Coding / Token / Agent plan tracker (personal use)" />
    <title data-i18n={titleText ? null : docTitleKey}>{docTitleZh}</title>
    <script is:inline>
      /* Resolve language + currency before first paint:
         language: stored choice > navigator.language (Accept-Language) > zh
         currency: stored choice > language default (zh->CNY, en->USD) */
      (function () {
        var root = document.documentElement;
        var savedLang = null;
        try { savedLang = localStorage.getItem("planscope-lang"); } catch (e) {}
        var hint = (navigator.languages && navigator.languages[0]) || navigator.language || "";
        var lang = savedLang === "zh" || savedLang === "en"
          ? savedLang
          : (!hint ? "zh" : (/^zh/i.test(hint) ? "zh" : "en"));
        root.dataset.lang = lang;
        root.lang = lang === "en" ? "en" : "zh-CN";
        var savedCur = null;
        try { savedCur = localStorage.getItem("planscope-currency"); } catch (e) {}
        root.dataset.currency = savedCur === "cny" || savedCur === "usd"
          ? savedCur
          : (lang === "en" ? "usd" : "cny");
      })();
    </script>
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="brand" href={href("")}>PlanScope</a>
        <nav class="pages">
          {NAV.map(([path, key]) => (
            <a href={href(path)} aria-current={current === path ? "page" : undefined}>
              <T k={key} />
            </a>
          ))}
        </nav>
        <div class="switches">
          <div class="lang-switch" role="group" aria-label="Language" data-i18n-attr="aria-label:common.langLabel">
            <button type="button" data-lang-btn="zh" aria-pressed="true">中文</button>
            <button type="button" data-lang-btn="en" aria-pressed="false">EN</button>
          </div>
          <div class="cur-switch" role="group" aria-label="Currency" data-i18n-attr="aria-label:common.currencyLabel">
            <button type="button" data-cur-btn="cny" aria-pressed="true">CNY</button>
            <button type="button" data-cur-btn="usd" aria-pressed="false">USD</button>
          </div>
        </div>
      </div>
    </header>

    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="site">
      <div class="wrap">
        <p><T k="footer.project" /></p>
        <p class="small"><T k="footer.trademark" /></p>
        <p class="small mono"><T k="footer.generated" vars={{ time: generated }} /></p>
      </div>
    </footer>

    <script>
      import { t, DEFAULT_CURRENCY } from "../i18n/index.js";

      const root = document.documentElement;
      const LANG_KEY = "planscope-lang";
      const CUR_KEY = "planscope-currency";

      function store(key, value) {
        try { localStorage.setItem(key, value); } catch (e) {}
      }
      function read(key) {
        try { return localStorage.getItem(key); } catch (e) { return null; }
      }
      function currentLang() {
        return root.dataset.lang === "en" ? "en" : "zh";
      }
      function currentCurrency() {
        return root.dataset.currency === "usd" ? "usd" : "cny";
      }

      // Attribute-level translations (placeholder / aria-label / title) and
      // whole-element text (e.g. <option>, <title>). Content-level messages are
      // rendered by <T /> in both languages and toggled by CSS.
      function applyTranslations(lang) {
        document.querySelectorAll("[data-i18n]").forEach((el) => {
          const key = el.getAttribute("data-i18n");
          if (key) el.textContent = t(lang, key);
        });
        document.querySelectorAll("[data-i18n-attr]").forEach((el) => {
          const spec = el.getAttribute("data-i18n-attr") || "";
          spec.split(",").forEach((pair) => {
            const i = pair.indexOf(":");
            if (i < 0) return;
            const attr = pair.slice(0, i).trim();
            const key = pair.slice(i + 1).trim();
            if (attr && key) el.setAttribute(attr, t(lang, key));
          });
        });
      }

      function syncLangButtons(lang) {
        document.querySelectorAll("[data-lang-btn]").forEach((btn) => {
          btn.setAttribute("aria-pressed", btn.getAttribute("data-lang-btn") === lang ? "true" : "false");
        });
      }
      function syncCurButtons(cur) {
        document.querySelectorAll("[data-cur-btn]").forEach((btn) => {
          btn.setAttribute("aria-pressed", btn.getAttribute("data-cur-btn") === cur ? "true" : "false");
        });
      }

      function setLang(lang, persist = true) {
        root.dataset.lang = lang;
        root.lang = lang === "en" ? "en" : "zh-CN";
        if (persist) store(LANG_KEY, lang);
        applyTranslations(lang);
        syncLangButtons(lang);
        // Currency follows the language default until the user picks one.
        if (!read(CUR_KEY)) setCurrency(DEFAULT_CURRENCY[lang], false);
        window.dispatchEvent(new CustomEvent("planscope:langchange", { detail: { lang } }));
      }

      function setCurrency(cur, persist = true) {
        root.dataset.currency = cur;
        if (persist) store(CUR_KEY, cur);
        syncCurButtons(cur);
        window.dispatchEvent(new CustomEvent("planscope:currencychange", { detail: { currency: cur } }));
      }

      applyTranslations(currentLang());
      syncLangButtons(currentLang());
      syncCurButtons(currentCurrency());

      document.querySelectorAll("[data-lang-btn]").forEach((btn) => {
        btn.addEventListener("click", () => setLang(btn.getAttribute("data-lang-btn") || "zh"));
      });
      document.querySelectorAll("[data-cur-btn]").forEach((btn) => {
        btn.addEventListener("click", () => setCurrency(btn.getAttribute("data-cur-btn") || "cny"));
      });
    </script>
  </body>
</html>
