---
import { href } from "../lib/base.js";
import { data } from "../lib/data.js";
import "../styles/global.css";

const NAV = [
  ["", "概览", "Overview"],
  ["providers/", "服务商", "Providers"],
  ["plans/", "套餐", "Plans"],
  ["models/", "模型", "Models"],
  ["pricing/", "价格", "Pricing"],
  ["privacy/", "隐私", "Privacy"],
  ["reliability/", "可靠性", "Reliability"],
  ["changes/", "变更", "Changes"],
  ["sources/", "来源", "Sources"],
  ["methodology/", "方法论", "Methodology"],
];

const ZH_TITLE = {
  Overview: "概览",
  Providers: "服务商",
  Plans: "套餐",
  Models: "模型",
  Pricing: "价格",
  Privacy: "隐私",
  Reliability: "可靠性",
  Changes: "变更",
  Sources: "来源",
  Methodology: "方法论",
};

const { title = "PlanScope", current = "" } = Astro.props;
const generated = data.generated_at ? data.generated_at.slice(0, 19).replace("T", " ") : "—";
const zhTitle = ZH_TITLE[title] || title;
---

<!doctype html>
<html lang="zh-CN" data-lang="zh">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="PlanScope — AI Coding / Token / Agent plan tracker (personal use)" />
    <title data-en-text={`${title} · PlanScope`}>{zhTitle} · PlanScope</title>
    <script is:inline>
      /* Resolve the language before first paint:
         1. explicit choice in localStorage
         2. browser language hint (navigator.language follows the Accept-Language request header)
         3. default = Chinese; any non-Chinese hint = English */
      (function () {
        function set(lang) {
          document.documentElement.dataset.lang = lang;
          document.documentElement.lang = lang === "en" ? "en" : "zh-CN";
        }
        var saved = null;
        try {
          saved = localStorage.getItem("planscope-lang");
        } catch (e) {}
        if (saved === "zh" || saved === "en") {
          set(saved);
          return;
        }
        var hint = (navigator.languages && navigator.languages[0]) || navigator.language || "";
        if (!hint) set("zh");
        else set(/^zh/i.test(hint) ? "zh" : "en");
      })();
    </script>
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="brand" href={href("")}>PlanScope</a>
        <nav class="pages">
          {NAV.map(([path, zh, en]) => (
            <a
              href={href(path)}
              aria-current={current === path ? "page" : undefined}
            ><span class="i18n-zh" lang="zh-CN">{zh}</span><span class="i18n-en" lang="en">{en}</span></a>
          ))}
        </nav>
        <div class="lang-switch" role="group" aria-label="语言 / Language" data-en-aria-label="Language">
          <button type="button" data-lang-btn="zh" aria-pressed="true">中文</button>
          <button type="button" data-lang-btn="en" aria-pressed="false">EN</button>
        </div>
      </div>
    </header>

    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="site">
      <div class="wrap">
        <p>
          <span class="i18n-zh" lang="zh-CN">
            PlanScope 是个人自用研究项目，非商业产品、非 SaaS、无返利/推广链接。
            数据不保证实时正确，请以官方来源为准。
          </span><span class="i18n-en" lang="en">
            PlanScope is a personal research project — not a commercial product, not a SaaS,
            no affiliate or referral links. Data may not be current; verify against official sources.
          </span>
        </p>
        <p class="small">
          <span class="i18n-zh" lang="zh-CN">
            本站使用的商标与产品名称（含 GLM、Kimi、Zhipu、Z.ai、OpenCode、OpenAI 等）
            仅用于标识所记录对象，与相关官方无任何关系；本站仅记录公开套餐与 Token 额度信息，
            不鼓励违反用户手册 / 隐私政策 / 使用说明的调用。
            Trademarks belong to their respective owners; this project is unaffiliated with any official entity.
          </span><span class="i18n-en" lang="en">
            Trademarks and product names used on this site (GLM, Kimi, Zhipu, Z.ai, OpenCode, OpenAI, etc.)
            identify the recorded subjects only and imply no affiliation with any official entity.
            This project records publicly offered plans and token quotas only, and does not encourage
            any invocation that violates a vendor's manual, privacy policy, or terms of use.
            Trademarks belong to their respective owners; this project is unaffiliated with any official entity.
          </span>
        </p>
        <p class="small mono">
          <span class="i18n-zh" lang="zh-CN">数据生成时间（UTC+8）：{generated}</span><span class="i18n-en" lang="en">Data generated (UTC+8): {generated}</span>
        </p>
      </div>
    </footer>

    <script>
      // Applies attribute-level translations and owns the 中文 / EN toggle.
      // Content-level translations are plain markup spans (.i18n-zh / .i18n-en) toggled by CSS.
      const ATTRS = [
        ["data-en-text", "textContent"],
        ["data-en-placeholder", "placeholder"],
        ["data-en-aria-label", "aria-label"],
        ["data-en-title", "title"],
      ];

      const currentLang = () =>
        document.documentElement.dataset.lang === "en" ? "en" : "zh";

      function applyText(lang) {
        for (const [attr, prop] of ATTRS) {
          document.querySelectorAll(`[${attr}]`).forEach((el) => {
            const cache = `__zh_${prop}`;
            if (!(cache in el)) {
              el[cache] = prop === "textContent" ? el.textContent : el.getAttribute(prop);
            }
            const value = lang === "en" ? el.getAttribute(attr) : el[cache];
            if (prop === "textContent") el.textContent = value;
            else el.setAttribute(prop, value);
          });
        }
      }

      function syncButtons(lang) {
        document.querySelectorAll("[data-lang-btn]").forEach((btn) => {
          btn.setAttribute(
            "aria-pressed",
            btn.getAttribute("data-lang-btn") === lang ? "true" : "false"
          );
        });
      }

      function setLang(lang) {
        const root = document.documentElement;
        root.dataset.lang = lang;
        root.lang = lang === "en" ? "en" : "zh-CN";
        try {
          localStorage.setItem("planscope-lang", lang);
        } catch (e) {}
        applyText(lang);
        syncButtons(lang);
        window.dispatchEvent(new CustomEvent("planscope:langchange", { detail: { lang } }));
      }

      const initial = currentLang();
      applyText(initial);
      syncButtons(initial);
      document.querySelectorAll("[data-lang-btn]").forEach((btn) => {
        btn.addEventListener("click", () => setLang(btn.getAttribute("data-lang-btn") || "zh"));
      });
    </script>
  </body>
</html>
