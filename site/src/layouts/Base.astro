---
import { href } from "../lib/base.js";
import { data } from "../lib/data.js";
import "../styles/global.css";

const NAV = [
  ["", "Overview"],
  ["providers/", "Providers"],
  ["plans/", "Plans"],
  ["models/", "Models"],
  ["pricing/", "Pricing"],
  ["privacy/", "Privacy"],
  ["reliability/", "Reliability"],
  ["changes/", "Changes"],
  ["sources/", "Sources"],
  ["methodology/", "Methodology"],
];

const { title = "PlanScope", current = "" } = Astro.props;
const generated = data.generated_at ? data.generated_at.slice(0, 19).replace("T", " ") : "—";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="PlanScope — AI Coding / Token / Agent plan tracker (personal use)" />
    <title>{title} · PlanScope</title>
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="brand" href={href("")}>PlanScope</a>
        <nav class="pages">
          {NAV.map(([path, label]) => (
            <a
              href={href(path)}
              aria-current={current === path ? "page" : undefined}
            >{label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="site">
      <div class="wrap">
        <p>
          PlanScope 是个人自用研究项目，非商业产品、非 SaaS、无返利/推广链接。
          数据不保证实时正确，请以官方来源为准。
        </p>
        <p class="small">
          本站使用的商标与产品名称（含 GLM、Kimi、Zhipu、Z.ai、OpenCode、OpenAI 等）
          仅用于标识所记录对象，与相关官方无任何关系；本站仅记录公开套餐与 Token 额度信息，
          不鼓励违反用户手册 / 隐私政策 / 使用说明的调用。
          Trademarks belong to their respective owners; this project is unaffiliated with any official entity.
        </p>
        <p class="small mono">数据生成时间（UTC+8）：{generated}</p>
      </div>
    </footer>
  </body>
</html>
