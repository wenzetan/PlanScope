---
import Base from "../layouts/Base.astro";
import { data } from "../lib/data.js";
import { display, money, cny, statusBadge, when } from "../lib/format.js";

const providerOptions = [...new Set(data.plans.map((p) => p.provider))].sort();
const typeOptions = [...new Set(data.plans.flatMap((p) => p.type || []))].sort();
const regionOptions = [...new Set(data.plans.map((p) => p.region).filter(Boolean))].sort();
const audienceOptions = [...new Set(data.plans.map((p) => p.audience).filter(Boolean))].sort();
const kindOptions = [...new Set(data.plans.map((p) => p.record_kind).filter(Boolean))].sort();

function fmtWindow(w) {
  const label =
    w.label || (w.duration_hours ? `${w.duration_hours}h` : w.duration_days ? `${w.duration_days}d` : "");
  const amount = typeof w.amount === "number" ? w.amount.toLocaleString("en-US") : w.amount;
  return `${amount ?? "—"}${w.unit ? " " + w.unit : ""}${label ? " / " + label : ""}`;
}

function fmtEstimate(est) {
  if (!est || !Array.isArray(est.models) || est.models.length === 0) return null;
  return est.models
    .map((m) => {
      const min = m.minimum_million_tokens;
      const max = m.maximum_million_tokens;
      const range = min != null && max != null ? `${min}M–${max}M` : min != null ? `${min}M` : max != null ? `${max}M` : "?";
      return `${m.model}: ${range}`;
    })
    .join(" · ");
}

function fmtAmount(value) {
  return typeof value === "number" ? value.toLocaleString("en-US") : value;
}

const rows = data.plans.map((plan) => {
  const compat = plan.compatibility || {};
  const perSeat = plan.price_view && plan.price_view.billing_model === "per_seat";
  const kind = plan.record_kind || "subscription";
  const compatSummary = Object.entries(compat)
    .map(([key, value]) => `${key}: ${value ?? "unknown"}`)
    .join(" · ");
  const search = [
    plan.name,
    plan.id,
    plan.provider,
    plan.provider_name,
    plan.region,
    plan.market,
    plan.audience,
    kind,
    perSeat ? "seat per-seat 席位" : "",
    ...(plan.type || []),
    compatSummary,
  ]
    .filter(Boolean)
    .join(" ")
    .toLowerCase();
  return { plan, search, compatSummary, kind };
});
---

<Base title="Plans" current="plans/">
  <h1>Plans</h1>
  <p class="lead"><span class="i18n-zh" lang="zh-CN">核心对比页。价格保留原始币种；CNY 为派生值；额度中的厂商原话（Unlimited / Fair Use 等）原样展示。</span><span class="i18n-en" lang="en">The main comparison page. Prices keep their original currency; CNY is derived; vendor wording (Unlimited / Fair Use, etc.) is quoted verbatim.</span></p>

  <div class="toolbar">
    <input id="q" type="search" placeholder="搜索 plan / provider / 兼容性…" data-en-placeholder="Search plan / provider / compatibility…" aria-label="搜索套餐" data-en-aria-label="Search plans" />
    <select id="f-kind" aria-label="按记录类型筛选" data-en-aria-label="Filter by record kind">
      <option value="plans" selected data-en-text="Plans (subscription + legacy)">套餐（subscription + legacy）</option>
      <option value="all" data-en-text="All records">全部记录</option>
      {kindOptions.map((k) => <option value={k}>{k}</option>)}
    </select>
    <select id="f-provider" aria-label="按 Provider 筛选" data-en-aria-label="Filter by provider">
      <option value="" data-en-text="All providers">全部 Provider</option>
      {providerOptions.map((id) => <option value={id}>{id}</option>)}
    </select>
    <select id="f-type" aria-label="按套餐类型筛选" data-en-aria-label="Filter by plan type">
      <option value="" data-en-text="All types">全部类型</option>
      {typeOptions.map((type) => <option value={type}>{type}</option>)}
    </select>
    <select id="f-status" aria-label="按状态筛选" data-en-aria-label="Filter by status">
      <option value="" data-en-text="All statuses">全部状态</option>
      {[...new Set(data.plans.map((p) => p.status))].sort().map((s) => <option value={s}>{s}</option>)}
    </select>
    <select id="f-region" aria-label="按区域筛选" data-en-aria-label="Filter by region">
      <option value="" data-en-text="All regions">全部区域</option>
      {regionOptions.map((r) => <option value={r}>{r}</option>)}
    </select>
    <select id="f-audience" aria-label="按人群筛选" data-en-aria-label="Filter by audience">
      <option value="" data-en-text="All audiences">全部人群</option>
      {audienceOptions.map((a) => <option value={a}>{a}</option>)}
    </select>
    <span class="count" id="count"><span class="i18n-zh" lang="zh-CN">{rows.length} / {rows.length} 个套餐</span><span class="i18n-en" lang="en">{rows.length} / {rows.length} plans</span></span>
  </div>

  <div class="table-scroll">
    <table id="plans-table">
      <thead>
        <tr>
          <th class="sortable" data-sort="provider">Provider</th>
          <th class="sortable" data-sort="name"><span class="i18n-zh" lang="zh-CN">套餐</span><span class="i18n-en" lang="en">Plan</span></th>
          <th><span class="i18n-zh" lang="zh-CN">类型</span><span class="i18n-en" lang="en">Type</span></th>
          <th><span class="i18n-zh" lang="zh-CN">区域</span><span class="i18n-en" lang="en">Region</span></th>
          <th><span class="i18n-zh" lang="zh-CN">人群</span><span class="i18n-en" lang="en">Audience</span></th>
          <th class="sortable" data-sort="status"><span class="i18n-zh" lang="zh-CN">状态</span><span class="i18n-en" lang="en">Status</span></th>
          <th class="sortable" data-sort="kind"><span class="i18n-zh" lang="zh-CN">记录类型</span><span class="i18n-en" lang="en">Kind</span></th>
          <th class="sortable" data-sort="monthly"><span class="i18n-zh" lang="zh-CN">月价（原币种）</span><span class="i18n-en" lang="en">Monthly (original)</span></th>
          <th class="sortable" data-sort="monthly-cny"><span class="i18n-zh" lang="zh-CN">月价（CNY）</span><span class="i18n-en" lang="en">Monthly (CNY)</span></th>
          <th class="sortable" data-sort="annual"><span class="i18n-zh" lang="zh-CN">年价（可派生）</span><span class="i18n-en" lang="en">Annual (derived ok)</span></th>
          <th><span class="i18n-zh" lang="zh-CN">Token / 滚动额度</span><span class="i18n-en" lang="en">Token / rolling quota</span></th>
          <th><span class="i18n-zh" lang="zh-CN">Coding / Agent 兼容性</span><span class="i18n-en" lang="en">Coding / Agent compatibility</span></th>
          <th><span class="i18n-zh" lang="zh-CN">最近核查</span><span class="i18n-en" lang="en">Last checked</span></th>
        </tr>
      </thead>
      <tbody>
        {rows.map(({ plan, search, compatSummary }) => (
          <tr
            data-search={search}
            data-provider={plan.provider || ""}
            data-type={(plan.type || []).join(",")}
            data-region={plan.region || ""}
            data-audience={plan.audience || ""}
            data-status={plan.status || "unknown"}
            data-kind={plan.record_kind || "subscription"}
            data-name={(plan.name || "").toLowerCase()}
            data-monthly={plan.price_view.monthly ?? ""}
            data-monthly-cny={plan.price_view.monthly_cny ?? ""}
            data-annual={plan.price_view.annual_shown ?? ""}
          >
            <td>{display(plan.provider_name, plan.provider)}</td>
            <td class="wrap-cell">
              {display(plan.name)}
              <div class="mono small muted">{plan.provider}/{plan.id}</div>
              {plan.market && <div class="mono small muted">market: {plan.market}</div>}
            </td>
            <td>{display(plan.type)}</td>
            <td>{plan.region ? <span class="badge">{plan.region}</span> : "—"}</td>
            <td>{plan.audience ? <span class="badge">{plan.audience}</span> : "—"}</td>
            <td><span class={`badge ${statusBadge(plan.status).cls}`}>{statusBadge(plan.status).label}</span></td>
            <td><span class="badge">{plan.record_kind || "subscription"}</span></td>
            <td>
              {money(plan.price_view.monthly, plan.price_view.currency)}
              {plan.price_view.billing_model === "per_seat" && plan.price_view.monthly !== null && <span class="small muted"> <span class="i18n-zh" lang="zh-CN">/席</span><span class="i18n-en" lang="en">/seat</span></span>}
              {plan.price_view.current_offer_amount !== null && plan.price_view.current_offer_amount !== undefined && (
                <div class="small muted">
                  offer: {money(plan.price_view.current_offer_amount, plan.price_view.currency)}
                </div>
              )}
              {(plan.price_view.offers || []).map((o) =>
                o && o.amount !== null && o.amount !== undefined ? (
                  <div class="small muted">
                    {o.market || o.region || "offer"}: {money(o.amount, o.currency)}
                    {o.billing_model === "per_seat" ? " /seat" : ""}
                  </div>
                ) : null
              )}
            </td>
            <td>
              {cny(plan.price_view.monthly_cny)}
              {plan.price_view.billing_model === "per_seat" && plan.price_view.monthly !== null && <span class="small muted"> <span class="i18n-zh" lang="zh-CN">/席</span><span class="i18n-en" lang="en">/seat</span></span>}
              {plan.price_view.currency && plan.price_view.monthly !== null && plan.price_view.monthly_cny === null && (
                <div class="small muted">not directly comparable</div>
              )}
            </td>
            <td>
              {plan.price_view.annual_shown !== null
                ? <>
                    {money(plan.price_view.annual_shown, plan.price_view.currency)}
                    {plan.price_view.billing_model === "per_seat" && <span class="small muted"> <span class="i18n-zh" lang="zh-CN">/席</span><span class="i18n-en" lang="en">/seat</span></span>}
                    {" / "}{cny(plan.price_view.annual_cny)}
                    {plan.price_view.billing_model === "per_seat" && <span class="small muted"> <span class="i18n-zh" lang="zh-CN">/席</span><span class="i18n-en" lang="en">/seat</span></span>}
                    {plan.price_view.annual_derived && (
                      <div class="small muted">
                        derived: <span class="i18n-zh" lang="zh-CN">{cny(plan.price_view.annual_effective_monthly)}/月 × 12</span><span class="i18n-en" lang="en">{cny(plan.price_view.annual_effective_monthly)}/mo × 12</span>
                      </div>
                    )}
                  </>
                : "—"}
            </td>
            <td class="wrap-cell">
              {display(plan.quota_view.token, "—")}{" "}
              {(plan.quota_view.rolling_windows || []).length > 0 && (
                <span class="mono small">[{(plan.quota_view.rolling_windows || []).join(", ")}]</span>
              )}
              {(plan.quota_view.windows || []).length > 0 && (
                <div class="mono small">
                  {(plan.quota_view.windows || []).map((w) => fmtWindow(w)).join(" · ")}
                </div>
              )}
              {fmtEstimate(plan.estimated_weekly_tokens) && (
                <div class="small muted">
                  ≈ {fmtEstimate(plan.estimated_weekly_tokens)} tokens/week (official estimate
                  {plan.estimated_weekly_tokens?.basis?.cache_hit_rate != null
                    ? `, ${Math.round(plan.estimated_weekly_tokens.basis.cache_hit_rate * 100)}% cache hit`
                    : ""}
                  )
                </div>
              )}
              {(plan.quota_view.published_references || []).length > 0 && (
                <div class="small muted">
                  页仍显示参考值（非 canonical）:{" "}
                  {(plan.quota_view.published_references || [])
                    .map((r) => `${fmtAmount(r.amount)} ${r.unit}${r.window ? " / " + r.window : ""}`)
                    .join(" · ")}
                </div>
              )}
              {plan.quota_view.allocation_scope && (
                <div class="small muted">quota scope: {plan.quota_view.allocation_scope}</div>
              )}
              {plan.extra_usage?.supported && (
                <div class="small muted">
                  overage PAYG
                  {plan.extra_usage.admin_enable_required ? " (admin-enabled)" : ""}
                  {plan.extra_usage.budget_control ? " · budget control" : ""}
                </div>
              )}
              {plan.quota_view.refresh_period && (
                <div class="small muted">
                  quota refresh: {plan.quota_view.refresh_period}
                  {plan.quota_view.allocation_scope ? ` · ${plan.quota_view.allocation_scope}` : ""}
                  {plan.price_view.billing_model === "per_seat" && (
                    <>
                      {" · "}
                      <span class="i18n-zh" lang="zh-CN">年付≠年度发额度</span><span class="i18n-en" lang="en">billed yearly ≠ yearly quota</span>
                    </>
                  )}
                </div>
              )}
              {plan.quota_view.shared_pool_enabled && (
                <div class="small muted">
                  shared pool ({display(plan.quota_view.shared_pool_refresh, "?")}
                  {plan.quota_view.shared_pool_rollover === false ? ", no rollover" : ""})
                </div>
              )}
              {plan.quota_view.agent_tasks_approx !== null && plan.quota_view.agent_tasks_approx !== undefined && (
                <div class="small muted">≈ {plan.quota_view.agent_tasks_approx} agent tasks (approx)</div>
              )}
              {plan.quota_view.usage_policy && <div class="small">“{plan.quota_view.usage_policy}”</div>}
            </td>
            <td class="wrap-cell small">{display(compatSummary, "—")}</td>
            <td class="mono">{when(plan.checked_at)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {rows.length === 0 && <div class="empty"><span class="i18n-zh" lang="zh-CN">暂无 Plan 数据（先运行 planscope export-site-data）。</span><span class="i18n-en" lang="en">No plan data yet (run planscope export-site-data first).</span></div>}

  <p class="note small">
    <span class="i18n-zh" lang="zh-CN">
      兼容状态取值：full / officially_supported / partial / unofficial / unsupported / unsupported_by_plan / unknown ——
      “兼容 OpenAI API” 不等于 “完全兼容”；officially_supported = 官方文档明确支持（未做全量核验）；
      unsupported_by_plan = 平台支持但本套餐不含该能力（如 Go 无 Kimi Code）。
      无法诚实换算为单价的套餐会标记 <span class="mono">not directly comparable</span>，不强行估算。
    </span><span class="i18n-en" lang="en">
      Compatibility values: full / officially_supported / partial / unofficial / unsupported / unsupported_by_plan / unknown ——
      “OpenAI-API compatible” does not mean “fully compatible”; officially_supported = explicitly documented by the vendor
      (not exhaustively re-verified); unsupported_by_plan = the platform supports it but this plan does not include it
      (e.g. Go has no Kimi Code). Plans that cannot honestly be converted to a unit price are marked
      <span class="mono">not directly comparable</span> instead of being force-estimated.
    </span>
  </p>

  <script>
    const table = document.getElementById("plans-table");
    if (table) {
      const rows = Array.from(table.querySelectorAll("tbody tr"));
      const q = document.getElementById("q");
      const fp = document.getElementById("f-provider");
      const ft = document.getElementById("f-type");
      const fs = document.getElementById("f-status");
      const fr = document.getElementById("f-region");
      const fa = document.getElementById("f-audience");
      const fk = document.getElementById("f-kind");
      const count = document.getElementById("count");
      const total = rows.length;
      const PLAN_KINDS = ["subscription", "legacy_subscription"];

      function kindMatches(kind, filter) {
        if (!filter || filter === "all") return true;
        if (filter === "plans") return PLAN_KINDS.includes(kind);
        return kind === filter;
      }

      function apply() {
        const text = (q && q.value ? q.value : "").trim().toLowerCase();
        const provider = fp && fp.value ? fp.value : "";
        const type = ft && ft.value ? ft.value : "";
        const status = fs && fs.value ? fs.value : "";
        const region = fr && fr.value ? fr.value : "";
        const audience = fa && fa.value ? fa.value : "";
        const kind = fk && fk.value ? fk.value : "all";
        let visible = 0;
        for (const row of rows) {
          const ok =
            (!text || (row.dataset.search || "").includes(text)) &&
            (!provider || row.dataset.provider === provider) &&
            (!type || (row.dataset.type || "").split(",").includes(type)) &&
            (!status || row.dataset.status === status) &&
            (!region || row.dataset.region === region) &&
            (!audience || row.dataset.audience === audience) &&
            kindMatches(row.dataset.kind || "subscription", kind);
          row.style.display = ok ? "" : "none";
          if (ok) visible += 1;
        }
        const suffix = document.documentElement.dataset.lang === "en" ? "plans" : "个套餐";
        if (count) count.textContent = `${visible} / ${total} ${suffix}`;
      }

      for (const el of [q, fp, ft, fs, fr, fa, fk]) {
        if (el) el.addEventListener("input", apply);
      }
      document.addEventListener("planscope:langchange", apply);
      apply();   // 初始按默认分组（真套餐）渲染

      let sortKey = "";
      let sortAsc = true;
      for (const th of table.querySelectorAll("th.sortable")) {
        th.addEventListener("click", () => {
          const key = th.dataset.sort || "";
          sortAsc = sortKey === key ? !sortAsc : true;
          sortKey = key;
          const sorted = [...rows].sort((a, b) => {
            const av = a.dataset[key] ?? "";
            const bv = b.dataset[key] ?? "";
            const an = parseFloat(av);
            const bn = parseFloat(bv);
            let result;
            if (!Number.isNaN(an) && !Number.isNaN(bn) && av !== "" && bv !== "") {
              result = an - bn;
            } else {
              result = String(av).localeCompare(String(bv));
            }
            return sortAsc ? result : -result;
          });
          const tbody = table.querySelector("tbody");
          if (tbody) for (const row of sorted) tbody.appendChild(row);
        });
      }
    }
  </script>
</Base>
