---
import Base from "../layouts/Base.astro";
import T from "../components/T.astro";
import { t } from "../i18n/index.js";
import { href } from "../lib/base.js";
import { data } from "../lib/data.js";
import { display, when } from "../lib/format.js";

const typeOptions = [...new Set(data.sources.map((s) => s.type).filter(Boolean))].sort();
---

<Base titleKey="sources" current="sources/">
  <h1><T k="sources.h1" /></h1>
  <p class="lead"><T k="sources.lead" /></p>

  <div class="toolbar">
    <input id="q" type="search" placeholder={t("zh", "sources.searchPlaceholder")} aria-label={t("zh", "sources.searchAria")} data-i18n-attr="placeholder:sources.searchPlaceholder,aria-label:sources.searchAria" />
    <select id="f-type" aria-label={t("zh", "sources.filterTypeAria")} data-i18n-attr="aria-label:sources.filterTypeAria">
      <option value="" data-i18n="sources.allTypes">{t("zh", "sources.allTypes")}</option>
      {typeOptions.map((type) => <option value={type}>{type}</option>)}
    </select>
    <span class="count" id="count"><T k="sources.count" vars={{ visible: data.sources.length, total: data.sources.length }} /></span>
  </div>

  <div class="table-scroll">
    <table id="sources-table">
      <thead>
        <tr>
          <th><T k="col.provider" /></th>
          <th><T k="sources.col.record" /></th>
          <th><T k="sources.col.type" /></th>
          <th>URL</th>
          <th><T k="sources.col.checkedAt" /></th>
          <th><T k="sources.col.usedFor" /></th>
          <th><T k="sources.col.confidence" /></th>
        </tr>
      </thead>
      <tbody>
        {data.sources.map((entry) => (
          <tr
            data-type={entry.type || ""}
            data-search={`${entry.record} ${entry.provider || ""} ${entry.url} ${entry.used_for || ""}`.toLowerCase()}
          >
            <td>{entry.provider ? <a href={href(`providers/${entry.provider}/`)}>{entry.provider_name || entry.provider}</a> : "—"}</td>
            <td class="mono small">{display(entry.record)}</td>
            <td><span class="badge">{display(entry.type, "—")}</span></td>
            <td><a href={entry.url} rel="noopener">{entry.url.replace(/^https?:\/\//, "").slice(0, 48)}</a></td>
            <td class="mono">{when(entry.checked_at)}</td>
            <td class="wrap-cell small">{display(entry.used_for)}</td>
            <td><span class={`badge ${display(entry.confidence, "unknown")}`}>{display(entry.confidence, "—")}</span></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {data.sources.length === 0 && <div class="empty"><T k="sources.empty" /></div>}

  <p class="note small">
    <T k="sources.note" vars={{ methodology: href("methodology/") }} />
  </p>

  <script>
    import { t } from "../i18n/index.js";

    const table = document.getElementById("sources-table");
    if (table) {
      const rows = Array.from(table.querySelectorAll("tbody tr"));
      const q = document.getElementById("q");
      const ft = document.getElementById("f-type");
      const count = document.getElementById("count");
      const total = rows.length;
      function apply() {
        const text = (q && q.value ? q.value : "").trim().toLowerCase();
        const type = ft && ft.value ? ft.value : "";
        let visible = 0;
        for (const row of rows) {
          const ok =
            (!text || (row.dataset.search || "").includes(text)) &&
            (!type || row.dataset.type === type);
          row.style.display = ok ? "" : "none";
          if (ok) visible += 1;
        }
        const lang = document.documentElement.dataset.lang === "en" ? "en" : "zh";
        if (count) count.textContent = t(lang, "sources.count", { visible, total });
      }
      for (const el of [q, ft]) if (el) el.addEventListener("input", apply);
      document.addEventListener("planscope:langchange", apply);
    }
  </script>
</Base>
