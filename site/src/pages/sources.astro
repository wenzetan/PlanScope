---
import Base from "../layouts/Base.astro";
import { href } from "../lib/base.js";
import { data } from "../lib/data.js";
import { display, when } from "../lib/format.js";

const typeOptions = [...new Set(data.sources.map((s) => s.type).filter(Boolean))].sort();
---

<Base title="Sources" current="sources/">
  <h1>Sources</h1>
  <p class="lead"><span class="i18n-zh" lang="zh-CN">“这个数字是从哪里来的？” —— 每条证据的 Provider、类型、URL、核查时间与用途。</span><span class="i18n-en" lang="en">“Where did this number come from?” — provider, type, URL, check date and purpose for every piece of evidence.</span></p>

  <div class="toolbar">
    <input id="q" type="search" placeholder="搜索 record / provider / url…" data-en-placeholder="Search record / provider / url…" aria-label="搜索来源" data-en-aria-label="Search sources" />
    <select id="f-type" aria-label="按来源类型筛选" data-en-aria-label="Filter by source type">
      <option value="" data-en-text="All types">全部类型</option>
      {typeOptions.map((type) => <option value={type}>{type}</option>)}
    </select>
    <span class="count" id="count"><span class="i18n-zh" lang="zh-CN">{data.sources.length} / {data.sources.length} 条来源</span><span class="i18n-en" lang="en">{data.sources.length} / {data.sources.length} sources</span></span>
  </div>

  <div class="table-scroll">
    <table id="sources-table">
      <thead>
        <tr>
          <th>Provider</th>
          <th><span class="i18n-zh" lang="zh-CN">记录</span><span class="i18n-en" lang="en">Record</span></th>
          <th><span class="i18n-zh" lang="zh-CN">来源类型</span><span class="i18n-en" lang="en">Source type</span></th>
          <th>URL</th>
          <th><span class="i18n-zh" lang="zh-CN">核查时间</span><span class="i18n-en" lang="en">Checked at</span></th>
          <th><span class="i18n-zh" lang="zh-CN">用途</span><span class="i18n-en" lang="en">Used for</span></th>
          <th><span class="i18n-zh" lang="zh-CN">置信度</span><span class="i18n-en" lang="en">Confidence</span></th>
        </tr>
      </thead>
      <tbody>
        {data.sources.map((entry) => (
          <tr
            data-type={entry.type || ""}
            data-search={`${entry.record} ${entry.provider || ""} ${entry.url} ${entry.used_for || ""}`.toLowerCase()}
          >
            <td>{entry.provider ? <a href={href(`providers/${entry.provider}/`)}>{entry.provider_name || entry.provider}</a> : "—"}</td>
            <td class="mono small">{display(entry.record)}</td>
            <td><span class="badge">{display(entry.type, "—")}</span></td>
            <td><a href={entry.url} rel="noopener">{entry.url.replace(/^https?:\/\//, "").slice(0, 48)}</a></td>
            <td class="mono">{when(entry.checked_at)}</td>
            <td class="wrap-cell small">{display(entry.used_for)}</td>
            <td><span class={`badge ${display(entry.confidence, "unknown")}`}>{display(entry.confidence, "—")}</span></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {data.sources.length === 0 && <div class="empty"><span class="i18n-zh" lang="zh-CN">暂无来源记录。</span><span class="i18n-en" lang="en">No source records yet.</span></div>}

  <p class="note small">
    <span class="i18n-zh" lang="zh-CN">
      来源优先级：official &gt; measured &gt; community。社区报告是信号，不是权威事实。
      详见 <a href={href("methodology/")}>方法论</a>。
    </span><span class="i18n-en" lang="en">
      Source priority: official &gt; measured &gt; community. Community reports are signals, not authoritative facts.
      See <a href={href("methodology/")}>Methodology</a>.
    </span>
  </p>

  <script>
    const table = document.getElementById("sources-table");
    if (table) {
      const rows = Array.from(table.querySelectorAll("tbody tr"));
      const q = document.getElementById("q");
      const ft = document.getElementById("f-type");
      const count = document.getElementById("count");
      const total = rows.length;
      function apply() {
        const text = (q && q.value ? q.value : "").trim().toLowerCase();
        const type = ft && ft.value ? ft.value : "";
        let visible = 0;
        for (const row of rows) {
          const ok =
            (!text || (row.dataset.search || "").includes(text)) &&
            (!type || row.dataset.type === type);
          row.style.display = ok ? "" : "none";
          if (ok) visible += 1;
        }
        const suffix = document.documentElement.dataset.lang === "en" ? "sources" : "条来源";
        if (count) count.textContent = `${visible} / ${total} ${suffix}`;
      }
      for (const el of [q, ft]) if (el) el.addEventListener("input", apply);
      document.addEventListener("planscope:langchange", apply);
    }
  </script>
</Base>
