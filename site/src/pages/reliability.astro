---
import Base from "../layouts/Base.astro";
import T from "../components/T.astro";
import { href } from "../lib/base.js";
import { data } from "../lib/data.js";
import { display, when } from "../lib/format.js";

function provenance(record) {
  const st = record.source_type || "unknown";
  if (st === "measured" || (record.metric && st === "unknown" && record.status === "measured")) return "measured";
  if (st === "official") return "official";
  if (st === "community_reported") return "community_reported";
  if (st === "estimated") return "estimated";
  return "unknown";
}
---

<Base titleKey="reliability" current="reliability/">
  <h1><T k="reliability.h1" /></h1>
  <p class="lead"><T k="reliability.lead" /></p>

  <ul class="plain small">
    <li><span class="badge measured"><T k="badge.measured" /></span> — <T k="reliability.provenance.measured" /></li>
    <li><span class="badge official"><T k="badge.official" /></span> — <T k="reliability.provenance.official" /></li>
    <li><span class="badge community_reported"><T k="badge.communityReported" /></span> — <T k="reliability.provenance.communityReported" /></li>
    <li><span class="badge estimated"><T k="badge.estimated" /></span> — <T k="reliability.provenance.estimated" /></li>
  </ul>

  <h2><T k="reliability.benchmarks.heading" /></h2>
  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th><T k="col.provider" /></th><th><T k="col.plan" /></th><th><T k="reliability.col.model" /></th>
          <th><T k="reliability.col.metric" /></th>
          <th><T k="reliability.col.value" /></th>
          <th><T k="reliability.col.unit" /></th>
          <th><T k="reliability.col.provenance" /></th>
          <th><T k="reliability.col.confidence" /></th>
          <th><T k="col.status" /></th>
          <th><T k="col.checked" /></th>
        </tr>
      </thead>
      <tbody>
        {data.benchmarks.map((record) => (
          <tr>
            <td>{record.provider ? <a href={href(`providers/${record.provider}/`)}>{record.provider}</a> : "—"}</td>
            <td class="mono">{display(record.plan)}</td>
            <td class="mono">{display(record.model)}</td>
            <td class="mono">{display(record.metric)}</td>
            <td>{record.value === null || record.value === undefined ? <span class="badge unknown"><T k="badge.unknown" /></span> : record.value}</td>
            <td>{display(record.unit)}</td>
            <td><span class={`badge ${provenance(record)}`}>{display(record.source_type, "unknown")}</span></td>
            <td><span class={`badge ${display(record.confidence, "unknown")}`}>{display(record.confidence, "unknown")}</span></td>
            <td>{display(record.status)}</td>
            <td class="mono">{when(record.checked_at)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {data.benchmarks.length === 0 && <div class="empty"><T k="reliability.benchmarks.empty" /></div>}

  <h2><T k="reliability.community.heading" /></h2>
  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th><T k="col.date" /></th>
          <th><T k="col.provider" /></th>
          <th><T k="reliability.col.risk" /></th>
          <th><T k="reliability.col.summary" /></th>
          <th><T k="reliability.col.sourceType" /></th>
          <th><T k="reliability.col.confidence" /></th>
          <th><T k="reliability.col.reproduced" /></th>
          <th><T k="reliability.col.link" /></th>
        </tr>
      </thead>
      <tbody>
        {data.community.map((record) => (
          <tr>
            <td class="mono">{when(record.occurred_at || record.checked_at)}</td>
            <td>{record.provider ? <a href={href(`providers/${record.provider}/`)}>{record.provider}</a> : "—"}</td>
            <td><span class="badge">{display(record.risk_type)}</span></td>
            <td class="wrap-cell">{display(record.summary)}</td>
            <td><span class={`badge ${provenance({ source_type: record.source_type })}`}>{display(record.source_type)}</span></td>
            <td><span class={`badge ${display(record.confidence, "unknown")}`}>{display(record.confidence)}</span></td>
            <td>{display(record.reproduced)}</td>
            <td>{record.url ? <a href={record.url} rel="noopener"><T k="reliability.community.source" /></a> : "—"}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {data.community.length === 0 && <div class="empty"><T k="reliability.community.empty" /></div>}

  <p class="note small"><T k="reliability.note" /></p>
</Base>
