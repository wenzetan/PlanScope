---
import Base from "../layouts/Base.astro";
import T from "../components/T.astro";
import Cur from "../components/Cur.astro";
import Money from "../components/Money.astro";
import { t } from "../i18n/index.js";
import { data } from "../lib/data.js";
import { display, money, when } from "../lib/format.js";

const rate = data.exchange_rate.usd_cny;
const rows = data.plans.map((plan) => ({
  plan,
  sortCny: plan.price_view.monthly_cny ?? Number.POSITIVE_INFINITY,
}));
rows.sort((a, b) => a.sortCny - b.sortCny);

// 席位计价的 Plan：seat_count 是数量不是档位，成本 = 单席年价 × N（展示层派生，绝不建多档文件）。
const perSeatPlans = data.plans.filter((p) => p.price_view && p.price_view.billing_model === "per_seat");
---

<Base titleKey="pricing" current="pricing/">
  <h1><T k="pricing.h1" /></h1>
  <p class="lead"><T k="pricing.lead" /></p>

  <div class="note">
    <T k="pricing.rateNote" vars={{ rate: rate ?? "—" }} />
  </div>

  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th><T k="col.provider" /></th>
          <th><T k="col.plan" /></th>
          <th><T k="pricing.col.original" /></th>
          <th><Cur k="pricing.col.converted" /></th>
          <th><T k="pricing.col.annualOriginal" /></th>
          <th><Cur k="pricing.col.annualConverted" /></th>
          <th><Cur k="pricing.col.effectiveInput" /></th>
          <th><Cur k="pricing.col.effectiveOutput" /></th>
          <th><T k="pricing.col.promotion" /></th>
          <th><T k="col.checked" /></th>
        </tr>
      </thead>
      <tbody>
        {rows.map(({ plan }) => {
          const perSeat = plan.price_view.billing_model === "per_seat";
          const notComparable = plan.token_rules && plan.token_rules.directly_comparable === false;
          return (
            <tr>
              <td>{display(plan.provider_name, plan.provider)}</td>
              <td class="wrap-cell">{display(plan.name)}</td>
              <td>
                {money(plan.price_view.monthly, plan.price_view.currency)}
                {perSeat && <span class="small muted"> <T k="common.perSeat" /></span>}
              </td>
              <td>
                <Money amount={plan.price_view.monthly} currency={plan.price_view.currency} rate={rate} />
                {perSeat && <span class="small muted"> <T k="common.perSeat" /></span>}
              </td>
              <td>
                {plan.price_view.annual_shown !== null ? (
                  <>
                    {money(plan.price_view.annual_shown, plan.price_view.currency)}
                    {perSeat && <span class="small muted"> <T k="common.perSeat" /></span>}
                    {plan.price_view.annual_derived && <span class="small muted"> <T k="common.derived" /></span>}
                  </>
                ) : "—"}
              </td>
              <td>
                {plan.price_view.annual_shown !== null ? (
                  <>
                    <Money amount={plan.price_view.annual_shown} currency={plan.price_view.currency} rate={rate} />
                    {perSeat && <span class="small muted"> <T k="common.perSeat" /></span>}
                    {plan.price_view.annual_derived && <span class="small muted"> <T k="common.derived" /></span>}
                  </>
                ) : "—"}
              </td>
              <td>{notComparable ? <T k="common.notDirectlyComparable" /> : "—"}</td>
              <td>{notComparable ? <T k="common.notDirectlyComparable" /> : "—"}</td>
              <td class="wrap-cell small">{display(plan.price_view.promotion, "—")}</td>
              <td class="mono">{when(plan.checked_at)}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  {rows.length === 0 && <div class="empty"><T k="pricing.empty" /></div>}

  {perSeatPlans.length > 0 && (
    <section>
      <h2><T k="pricing.seatCalc.h2" /></h2>
      <div class="note small"><T k="pricing.seatCalc.note" /></div>

      {perSeatPlans.map((plan) => {
        const pv = plan.price_view;
        const seats = (pv.seats && typeof pv.seats === "object") ? pv.seats : {};
        const minSeats = (seats.minimum && seats.minimum.value) || 1;
        const maxSeats = seats.maximum_per_purchase && seats.maximum_per_purchase.value;
        const minOrder = seats.minimum_order && seats.minimum_order.amount;
        const discounts = plan.pricing && plan.pricing.discounts;
        const annualPerSeat = pv.annual_shown;
        return (
          <div class="card" data-seat-calculator data-annual={annualPerSeat} data-min={minSeats} data-max={maxSeats ?? ""} data-currency={pv.currency ?? ""} data-rate={rate ?? ""}>
            <strong>{display(plan.provider_name, plan.provider)} · {display(plan.name)}</strong>
            <div class="mono small">
              {money(annualPerSeat, pv.currency)}<T k="common.perSeatPerYear" />
              {pv.annual_effective_monthly != null && (
                <>
                  <T k="pricing.seatCalc.monthlyAvg" vars={{ amount: money(pv.annual_effective_monthly, pv.currency) }} />
                </>
              )}
              {" · "}
              <T k="pricing.seatCalc.monthlyBilling" />
              {pv.monthly_billing_available === false
                ? <T k="pricing.seatCalc.monthlyBillingNo" />
                : <T k="pricing.seatCalc.monthlyBillingSee" />}
            </div>
            <div class="toolbar">
              <label class="small">
                <T k="pricing.seatCalc.seats" />{" "}
                <input
                  class="seat-input"
                  type="number"
                  value={minSeats}
                  min={minSeats}
                  max={maxSeats ?? undefined}
                  style="width: 90px"
                />
              </label>
              <span class="seat-output"></span>
            </div>
            <div class="small muted">
              <T k="pricing.seatCalc.minSeats" vars={{ min: minSeats }} />
              {maxSeats && <T k="pricing.seatCalc.maxSeats" vars={{ max: maxSeats }} />}
              {minOrder && <T k="pricing.seatCalc.minOrder" vars={{ amount: money(minOrder, pv.currency) }} />}
              {" · "}
              {discounts && discounts.publicly_available === false
                ? <T k="pricing.seatCalc.noDiscount" />
                : <T k="pricing.seatCalc.seeRaw" />}
              {" · "}
              <T k="pricing.seatCalc.prorate" />
            </div>
          </div>
        );
      })}

      <script>
        import { t } from "../i18n/index.js";

        function convert(amount, orig, disp, rate) {
          if (amount === null || amount === undefined || Number.isNaN(amount)) return null;
          const o = String(orig || "").toUpperCase();
          if (o === disp) return amount;
          if (!rate) return null;
          if (o === "CNY" && disp === "USD") return amount / rate;
          if (o === "USD" && disp === "CNY") return amount * rate;
          return null;
        }

        for (const box of document.querySelectorAll("[data-seat-calculator]")) {
          const annual = parseFloat(box.dataset.annual || "0");
          const min = parseInt(box.dataset.min || "1", 10);
          const maxRaw = box.dataset.max;
          const max = maxRaw ? parseInt(maxRaw, 10) : null;
          const orig = box.dataset.currency || "CNY";
          const rate = parseFloat(box.dataset.rate || "0") || null;
          const input = box.querySelector(".seat-input");
          const output = box.querySelector(".seat-output");

          const fmt = (n) => {
            const disp = document.documentElement.dataset.currency === "usd" ? "USD" : "CNY";
            const value = convert(n, orig, disp, rate);
            if (value === null) return "—";
            return (disp === "USD" ? "$" : "¥") + Math.round(value).toLocaleString("en-US");
          };

          const update = () => {
            if (!input || !output) return;
            let seats = parseInt(input.value || String(min), 10);
            if (Number.isNaN(seats)) seats = min;
            const bounded = Math.min(Math.max(seats, min), max ?? seats);
            const annualCost = annual * bounded;
            const monthlyCost = annualCost / 12;
            const lang = document.documentElement.dataset.lang === "en" ? "en" : "zh";
            const range = `${min}${max ? `–${max}` : "+"}`;
            output.innerHTML =
              t(lang, "pricing.seatCalc.output", { annual: fmt(annualCost), monthly: fmt(monthlyCost) }) +
              (seats !== bounded ? t(lang, "pricing.seatCalc.clamped", { range }) : "");
          };

          if (input) {
            input.addEventListener("input", update);
            update();
            document.addEventListener("planscope:langchange", update);
            document.addEventListener("planscope:currencychange", update);
          }
        }
      </script>
    </section>
  )}
</Base>
