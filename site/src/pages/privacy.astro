---
import Base from "../layouts/Base.astro";
import T from "../components/T.astro";
import { href } from "../lib/base.js";
import { data } from "../lib/data.js";
import { display, when } from "../lib/format.js";

const FIELDS = [
  ["prompt_retention", "privacy.field.prompt_retention"],
  ["output_retention", "privacy.field.output_retention"],
  ["log_retention_days", "privacy.field.log_retention_days"],
  ["used_for_training", "privacy.field.used_for_training"],
  ["training_default_opt_in", "privacy.field.training_default_opt_in"],
  ["opt_out_supported", "privacy.field.opt_out_supported"],
  ["zero_data_retention", "privacy.field.zero_data_retention"],
  ["enterprise_data_isolation", "privacy.field.enterprise_data_isolation"],
  ["third_party_model_routing", "privacy.field.third_party_model_routing"],
  ["subprocessors", "privacy.field.subprocessors"],
  ["data_region", "privacy.field.data_region"],
  ["cross_border_transfer", "privacy.field.cross_border_transfer"],
  ["api_web_policy_differs", "privacy.field.api_web_policy_differs"],
  ["coding_api_policy_differs", "privacy.field.coding_api_policy_differs"],
  ["sensitive_code_allowed", "privacy.field.sensitive_code_allowed"],
  ["commercial_code_allowed", "privacy.field.commercial_code_allowed"],
  ["automated_agent_allowed", "privacy.field.automated_agent_allowed"],
  ["account_sharing_forbidden", "privacy.field.account_sharing_forbidden"],
  ["proxy_forwarding_forbidden", "privacy.field.proxy_forwarding_forbidden"],
  ["api_gateway_restricted", "privacy.field.api_gateway_restricted"],
  ["coding_agent_tools_restricted", "privacy.field.coding_agent_tools_restricted"],
];
---

<Base titleKey="privacy" current="privacy/">
  <h1><T k="privacy.h1" /></h1>
  <p class="lead"><T k="privacy.lead" /></p>

  <ul class="plain small">
    <li><span class="badge official">official fact</span> — <T k="privacy.state.official" /></li>
    <li><span class="badge unknown">unknown</span> — <T k="privacy.state.unknown" /></li>
    <li><T k="privacy.state.communityBefore" /><a href={href("reliability/")}>community signal</a><T k="privacy.state.communityAfter" /></li>
  </ul>

  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th><T k="col.provider" /></th>
          {FIELDS.map(([, key]) => <th><T k={key} /></th>)}
          <th><T k="col.checked" /></th>
        </tr>
      </thead>
      <tbody>
        {data.privacy.map((record) => (
          <tr>
            <td><a href={href(`providers/${record.provider}/`)}>{record.provider}</a></td>
            {FIELDS.map(([field]) => {
              const entry = record[field];
              const value = entry ? entry.value : null;
              const official = entry && entry.source && value !== null;
              return (
                <td>
                  {value === null || value === undefined ? (
                    <span class="badge unknown">unknown</span>
                  ) : (
                    <span>
                      {display(value)}
                      {official && (
                        <>
                          {" "}
                          <a href={entry.source} rel="noopener" title={entry.source}>
                            <span class="badge official">official</span>
                          </a>
                        </>
                      )}
                    </span>
                  )}
                </td>
              );
            })}
            <td class="mono">{when(record.checked_at)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {data.privacy.length === 0 && <div class="empty"><T k="privacy.empty" /></div>}

  <p class="note small"><T k="privacy.note" /></p>
</Base>
