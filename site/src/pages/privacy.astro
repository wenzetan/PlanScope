---
import Base from "../layouts/Base.astro";
import { href } from "../lib/base.js";
import { data } from "../lib/data.js";
import { display, when } from "../lib/format.js";

const FIELDS = [
  ["prompt_retention", "Prompt 保留", "Prompt retention"],
  ["output_retention", "Output 保留", "Output retention"],
  ["log_retention_days", "日志保留", "Log retention"],
  ["used_for_training", "用于训练", "Training usage"],
  ["training_default_opt_in", "训练默认策略", "Training default"],
  ["opt_out_supported", "Opt-out", "Opt-out"],
  ["zero_data_retention", "Zero Data Retention", "Zero Data Retention"],
  ["enterprise_data_isolation", "企业数据隔离", "Enterprise isolation"],
  ["third_party_model_routing", "第三方模型路由", "Third-party routing"],
  ["subprocessors", "子处理方", "Subprocessors"],
  ["data_region", "数据地区", "Data region"],
  ["cross_border_transfer", "跨境传输", "Cross-border"],
  ["api_web_policy_differs", "API vs Web 政策差异", "API vs Web policy"],
  ["coding_api_policy_differs", "Coding vs API 政策差异", "Coding vs API policy"],
  ["sensitive_code_allowed", "敏感代码", "Sensitive code"],
  ["commercial_code_allowed", "商业代码", "Commercial code"],
  ["automated_agent_allowed", "自动化 Agent", "Automated agents"],
  ["account_sharing_forbidden", "禁止账号共享", "Account sharing forbidden"],
  ["proxy_forwarding_forbidden", "禁止代理转发", "Proxy forwarding forbidden"],
  ["api_gateway_restricted", "API 网关限制", "API gateway restricted"],
  ["coding_agent_tools_restricted", "Coding-agent 工具限制", "Coding-agent restrictions"],
];
---

<Base title="Privacy" current="privacy/">
  <h1>Privacy</h1>
  <p class="lead"><span class="i18n-zh" lang="zh-CN">隐私与数据政策是核心研究维度。每个字段区分三种状态：</span><span class="i18n-en" lang="en">Privacy and data policy are a core research dimension. Every field falls into one of three states:</span></p>

  <ul class="plain small">
    <li><span class="badge official">official fact</span> — <span class="i18n-zh" lang="zh-CN">有直接来源 URL（官方政策 / 条款）</span><span class="i18n-en" lang="en">backed by a direct source URL (official policy / terms)</span></li>
    <li><span class="badge unknown">unknown</span> — <span class="i18n-zh" lang="zh-CN">未查证，value 为 null，不猜测</span><span class="i18n-en" lang="en">not verified, value is null, never guessed</span></li>
    <li><span class="i18n-zh" lang="zh-CN">二手转述不进入本页，只作为 </span><span class="i18n-en" lang="en">Second-hand accounts never enter this page; they are only recorded as </span><a href={href("reliability/")}>community signal</a><span class="i18n-zh" lang="zh-CN"> 记录</span><span class="i18n-en" lang="en"></span></li>
  </ul>

  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>Provider</th>
          {FIELDS.map(([, zh, en]) => <th><span class="i18n-zh" lang="zh-CN">{zh}</span><span class="i18n-en" lang="en">{en}</span></th>)}
          <th><span class="i18n-zh" lang="zh-CN">最近核查</span><span class="i18n-en" lang="en">Last checked</span></th>
        </tr>
      </thead>
      <tbody>
        {data.privacy.map((record) => (
          <tr>
            <td><a href={href(`providers/${record.provider}/`)}>{record.provider}</a></td>
            {FIELDS.map(([field]) => {
              const entry = record[field];
              const value = entry ? entry.value : null;
              const official = entry && entry.source && value !== null;
              return (
                <td>
                  {value === null || value === undefined ? (
                    <span class="badge unknown">unknown</span>
                  ) : (
                    <span>
                      {display(value)}
                      {official && (
                        <>
                          {" "}
                          <a href={entry.source} rel="noopener" title={entry.source}>
                            <span class="badge official">official</span>
                          </a>
                        </>
                      )}
                    </span>
                  )}
                </td>
              );
            })}
            <td class="mono">{when(record.checked_at)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {data.privacy.length === 0 && <div class="empty"><span class="i18n-zh" lang="zh-CN">暂无隐私政策数据。</span><span class="i18n-en" lang="en">No privacy policy data yet.</span></div>}

  <p class="note small">
    <span class="i18n-zh" lang="zh-CN">
      API 与 Web 产品、Coding Plan 与普通 API 的政策可能不同，分别记录于
      <span class="mono">api_web_policy_differs</span> / <span class="mono">coding_api_policy_differs</span>。
      每个字段独立携带 source 与 checked_at。
    </span><span class="i18n-en" lang="en">
      API and Web products, or Coding Plans versus plain API, may follow different policies —
      recorded separately in <span class="mono">api_web_policy_differs</span> /
      <span class="mono">coding_api_policy_differs</span>. Every field carries its own source and checked_at.
    </span>
  </p>
</Base>
