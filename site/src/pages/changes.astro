---
import Base from "../layouts/Base.astro";
import T from "../components/T.astro";
import { data } from "../lib/data.js";
import { display, when } from "../lib/format.js";

const dates = [...new Set(data.changes.map((c) => c.date || "unknown"))].sort().reverse();
const byDate = new Map(dates.map((d) => [d, data.changes.filter((c) => (c.date || "unknown") === d)]));
---

<Base titleKey="changes" current="changes/">
  <h1><T k="changes.h1" /></h1>
  <p class="lead"><T k="changes.lead" /></p>

  {data.changes.length === 0 && <div class="empty"><T k="changes.empty" /></div>}

  {[...byDate.entries()].map(([date, changes]) => (
    <section class="changes-day">
      <h2 class="mono">{date}</h2>
      {changes.flatMap((change) =>
        (change.entries || []).map((entry) => (
          <div class="change-entry">
            <div>
              <span class={`badge ${entry.kind || "unknown"}`}>{display(entry.kind, "changed")}</span>{" "}
              <strong>{display(entry.provider)}</strong>
              {entry.plan && <span class="mono small muted"> / {entry.plan}</span>}
              {entry.field && <span class="muted small"> — {entry.field}</span>}
            </div>
            <div class="wrap-cell">{display(entry.summary)}</div>
            {(entry.before !== null || entry.after !== null) && entry.before !== entry.after && (
              <div class="delta">
                {display(entry.before)} → <strong>{display(entry.after)}</strong>
              </div>
            )}
            <div class="small muted">
              {display(change.notes)}<T k="changes.checked" />{when(entry.checked_at)}
            </div>
          </div>
        ))
      )}
    </section>
  ))}
</Base>
