---
import Base from "../layouts/Base.astro";
import T from "../components/T.astro";
import Cur from "../components/Cur.astro";
import { href } from "../lib/base.js";
import { data } from "../lib/data.js";
import { convert, display, fmtMoney } from "../lib/format.js";

const stats = data.stats;
const recentChanges = data.changes.slice(0, 3);
const rate = data.exchange_rate.usd_cny;

const NAV = [
  ["providers/", "providers"],
  ["plans/", "plans"],
  ["models/", "models"],
  ["pricing/", "pricing"],
  ["privacy/", "privacy"],
  ["reliability/", "reliability"],
  ["changes/", "changes"],
  ["sources/", "sources"],
  ["methodology/", "methodology"],
];
---

<Base titleKey="overview">
  <h1>{data.site.title}</h1>
  <p class="lead"><span class="i18n-zh" lang="zh-CN">{data.site.tagline_zh}</span><span class="i18n-en" lang="en">{data.site.tagline_en}</span></p>

  <div class="cards">
    <div class="card">
      <div class="num">{display(stats.generated_at ? stats.generated_at.slice(0, 16).replace("T", " ") : null)}</div>
      <div class="label"><T k="home.card.lastUpdate" /></div>
    </div>
    <div class="card">
      <div class="num">{stats.providers}</div>
      <div class="label"><T k="home.card.providers" /></div>
    </div>
    <div class="card">
      <div class="num">{stats.plans}</div>
      <div class="label"><T k="home.card.plans" /></div>
    </div>
    <div class="card">
      <div class="num">{stats.models}</div>
      <div class="label"><T k="home.card.models" /></div>
    </div>
    <div class="card">
      <div class="num">{data.exchange_rate.usd_cny !== null ? data.exchange_rate.usd_cny : "—"}</div>
      <div class="label"><T k="home.card.rate" /></div>
    </div>
  </div>

  <div class="note">
    <T k="home.rateNote" vars={{ methodology: href("methodology/") }} />
  </div>

  {recentChanges.length > 0 && (
    <>
      <h2><T k="home.recentChanges" /></h2>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th><T k="col.date" /></th>
              <th><T k="col.provider" /></th>
              <th><T k="col.change" /></th>
            </tr>
          </thead>
          <tbody>
            {recentChanges.flatMap((change) =>
              (change.entries || []).map((entry) => (
                <tr>
                  <td class="mono">{display(change.date)}</td>
                  <td>{display(entry.provider)}</td>
                  <td class="wrap-cell">{display(entry.summary)}</td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
      <p class="small"><a href={href("changes/")}><T k="home.viewAllChanges" /></a></p>
    </>
  )}

  <h2><T k="home.browse" /></h2>
  <div class="grid-nav">
    {NAV.map(([path, key]) => (
      <a href={href(path)}>
        <strong><T k={`home.nav.${key}.title`} /></strong>
        <div class="desc"><T k={`home.nav.${key}.desc`} /></div>
      </a>
    ))}
  </div>

  <p class="small muted" style="margin-top:24px">
    <Cur k="home.sample" vars={{ usd: fmtMoney(convert(140, "CNY", rate).usd, "USD") }} />
  </p>
</Base>
