---
import Base from "../layouts/Base.astro";
import T from "../components/T.astro";
import { data } from "../lib/data.js";
---

<Base titleKey="methodology" current="methodology/">
  <h1><T k="methodology.h1" /></h1>
  <p class="lead"><T k="methodology.lead" /></p>

  <h2><T k="methodology.section1" /></h2>
  <ol>
    <li><T k="methodology.source.official" /></li>
    <li><T k="methodology.source.measured" /></li>
    <li><T k="methodology.source.community" /></li>
  </ol>
  <p><T k="methodology.source.marketing" /></p>

  <h2><T k="methodology.section2" /></h2>
  <ul>
    <li><T k="methodology.unknown.unverified" /></li>
    <li><T k="methodology.unknown.vague" /></li>
    <li><T k="methodology.unknown.validator" /></li>
  </ul>

  <h2><T k="methodology.section3" /></h2>
  <ul>
    <li><T k="methodology.conflict.priority" /></li>
    <li><T k="methodology.conflict.keepBoth" /></li>
    <li><T k="methodology.conflict.unresolved" /></li>
  </ul>

  <h2><T k="methodology.section4" /></h2>
  <ul>
    <li><T k="methodology.exchange.avg" /></li>
  </ul>
  <p class="mono">weekly_average = sum(valid observations) / number of valid observations</p>
  <ul>
    <li><T k="methodology.exchange.validOnly" /></li>
    <li><T k="methodology.exchange.writeFile" /></li>
    <li><T k="methodology.exchange.singleSource" /></li>
    <li><T k="methodology.exchange.approx" /></li>
    <li><T k="methodology.exchange.currentValue" vars={{ value: data.exchange_rate.usd_cny ?? "—" }} /></li>
  </ul>

  <h2><T k="methodology.section5" /></h2>
  <p class="mono">CNY price = original price × usd_cny<T k="methodology.cny.condition" /></p>
  <ul>
    <li><T k="methodology.cny.keepOriginal" /></li>
    <li><T k="methodology.cny.promotion" /></li>
  </ul>

  <h2><T k="methodology.section6" /></h2>
  <ul>
    <li><T k="methodology.token.storeFacts" /></li>
    <li><T k="methodology.token.compute" /></li>
    <li><T k="methodology.token.unclear" /></li>
    <li><T k="methodology.token.noScore" /></li>
  </ul>

  <h2><T k="methodology.section7" /></h2>
  <ul>
    <li><T k="methodology.community.record" /></li>
    <li><T k="methodology.community.notFacts" /></li>
  </ul>

  <h2><T k="methodology.section8" /></h2>
  <p><span class="mono">official</span> / <span class="mono">measured</span> / <span class="mono">community_reported</span> / <span class="mono">estimated</span> <T k="methodology.benchmark.note" /></p>

  <h2><T k="methodology.section9" /></h2>
  <ul>
    <li><T k="methodology.history.iso" /></li>
    <li><T k="methodology.history.effective" /></li>
    <li><T k="methodology.history.retired" /></li>
    <li><T k="methodology.history.audit" /></li>
  </ul>

  <h2><T k="methodology.section10" /></h2>
  <div class="note">
    <span class="mono">data/**/*.yaml = canonical research data</span> ·
    <span class="mono">config/exchange_rate.yaml = <T k="methodology.arch.calcConfig" /></span> ·
    <span class="mono">Git history = <T k="methodology.arch.audit" /></span> ·
    <span class="mono">generated JSON = <T k="methodology.arch.derived" /></span> ·
    <span class="mono">Pages = <T k="methodology.arch.presentation" /></span> ·
    <span class="mono">README = <T k="methodology.arch.readme" /></span><br />
    <T k="methodology.arch.noDatabase" />
  </div>
</Base>
