---
import Base from "../../layouts/Base.astro";
import T from "../../components/T.astro";
import Cur from "../../components/Cur.astro";
import Money from "../../components/Money.astro";
import { href } from "../../lib/base.js";
import { data } from "../../lib/data.js";
import { display, money, statusBadge, when } from "../../lib/format.js";

const rate = data.exchange_rate.usd_cny;

export function getStaticPaths() {
  return data.providers.map((provider) => ({
    params: { id: provider.id },
    props: { provider },
  }));
}

const { provider } = Astro.props;
const plans = data.plans.filter((plan) => plan.provider === provider.id);
const models = data.models.filter((model) => model.provider === provider.id);
const privacyRecords = data.privacy.filter((record) => record.provider === provider.id);
const sources = data.sources.filter((entry) => entry.provider === provider.id);
const benchmarks = data.benchmarks.filter((entry) => entry.provider === provider.id);
const community = data.community.filter((entry) => entry.provider === provider.id);

const POLICY_FIELDS = [
  ["prompt_retention", "providers.detail.policy.prompt_retention"],
  ["output_retention", "providers.detail.policy.output_retention"],
  ["used_for_training", "providers.detail.policy.used_for_training"],
  ["training_default_opt_in", "providers.detail.policy.training_default_opt_in"],
  ["opt_out_supported", "providers.detail.policy.opt_out_supported"],
  ["zero_data_retention", "providers.detail.policy.zero_data_retention"],
  ["business_consumer_policy_differs", "providers.detail.policy.business_consumer_policy_differs"],
  ["subprocessors", "providers.detail.policy.subprocessors"],
  ["data_region", "providers.detail.policy.data_region"],
  ["cross_border_transfer", "providers.detail.policy.cross_border_transfer"],
  ["automated_agent_allowed", "providers.detail.policy.automated_agent_allowed"],
  ["coding_agent_tools_restricted", "providers.detail.policy.coding_agent_tools_restricted"],
];
---

<Base titleText={provider.name} current="providers/">
  <p class="small"><a href={href("providers/")}><T k="providers.detail.back" /></a></p>
  <h1>{display(provider.name)}</h1>
  <p class="lead mono">{provider.id}</p>

  <dl class="kv">
    <dt><T k="col.status" /></dt>
    <dd><span class={`badge ${statusBadge(provider.status).cls}`}>{statusBadge(provider.status).label}</span></dd>
    <dt><T k="providers.detail.officialWebsite" /></dt>
    <dd>{provider.website ? <a href={provider.website} rel="noopener">{provider.website}</a> : "—"}</dd>
    <dt><T k="col.docs" /></dt>
    <dd>{provider.docs ? <a href={provider.docs} rel="noopener">{provider.docs}</a> : "—"}</dd>
    <dt><T k="col.notes" /></dt>
    <dd>{display(provider.notes)}</dd>
    <dt><T k="col.checked" /></dt>
    <dd class="mono">{when(provider.checked_at)}</dd>
  </dl>

  <h2><T k="providers.detail.plans" /></h2>
  {plans.length ? (
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th><T k="col.plan" /></th>
            <th><T k="col.type" /></th>
            <th><T k="col.region" /></th>
            <th><T k="col.audience" /></th>
            <th><T k="col.status" /></th>
            <th><T k="providers.detail.monthly" /></th>
            <th><Cur k="providers.detail.converted" /></th>
            <th><T k="col.checked" /></th>
          </tr>
        </thead>
        <tbody>
          {plans.map((plan) => (
            <tr>
              <td class="wrap-cell">{display(plan.name)} <span class="mono small">{plan.id}</span></td>
              <td>{display(plan.type)}</td>
              <td>{plan.region ? <span class="badge">{plan.region}</span> : "—"}</td>
              <td>{plan.audience ? <span class="badge">{plan.audience}</span> : "—"}</td>
              <td><span class={`badge ${statusBadge(plan.status).cls}`}>{statusBadge(plan.status).label}</span></td>
              <td>{money(plan.price_view.monthly, plan.price_view.currency)}</td>
              <td><Money amount={plan.price_view.monthly} currency={plan.price_view.currency} rate={rate} /></td>
              <td class="mono">{when(plan.checked_at)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ) : <div class="empty"><T k="providers.detail.noPlans" /></div>}

  <h2><T k="providers.detail.compat" /></h2>
  {plans.length ? plans.map((plan) => (
    <h3>{display(plan.name)}</h3>
    <div class="table-scroll">
      <table>
        <thead><tr>
          <th><T k="providers.detail.surface" /></th>
          <th><T k="col.status" /></th>
        </tr></thead>
        <tbody>
          {Object.entries(plan.compatibility || {}).map(([surface, status]) => (
            <tr>
              <td class="mono">{surface}</td>
              <td><span class={`badge ${statusBadge(status).cls}`}>{display(status, "unknown")}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )) : <div class="empty"><T k="providers.detail.noCompat" /></div>}

  <h2><T k="providers.detail.models" /></h2>
  {models.length ? (
    <div class="table-scroll">
      <table>
        <thead><tr>
          <th>model_id</th>
          <th><T k="providers.detail.context" /></th>
          <th><T k="providers.detail.maxOutput" /></th>
          <th><T k="providers.detail.reasoning" /></th>
          <th><T k="providers.detail.toolCalling" /></th>
          <th><T k="col.status" /></th>
        </tr></thead>
        <tbody>
          {models.map((model) => (
            <tr>
              <td class="mono">{display(model.model_id)} {model.display_name && <span class="muted">({display(model.display_name)})</span>}</td>
              <td>{display(model.context_window)}</td>
              <td>{display(model.max_output)}</td>
              <td>{display(model.reasoning)}</td>
              <td>{display(model.tool_calling)}</td>
              <td><span class={`badge ${statusBadge(model.status).cls}`}>{statusBadge(model.status).label}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ) : <div class="empty"><T k="providers.detail.noModels" /></div>}

  <h2><T k="providers.detail.privacy" /></h2>
  {privacyRecords.length ? (
    privacyRecords.map((privacy) => (
      <>
        <h3>
          <span class="badge">{privacy.scope || privacy.id || "general"}</span>{" "}
          <span class="mono small">{privacy.id}</span>
        </h3>
        <div class="table-scroll">
          <table>
            <thead><tr>
              <th><T k="providers.detail.field" /></th>
              <th><T k="providers.detail.value" /></th>
              <th><T k="providers.detail.evidence" /></th>
              <th><T k="providers.detail.checkedAt" /></th>
            </tr></thead>
            <tbody>
              {POLICY_FIELDS.map(([field, labelKey]) => {
                const entry = privacy[field];
                const value = entry && entry.value !== undefined ? entry.value : null;
                const isOfficial = entry && entry.source && entry.value !== null;
                return (
                  <tr>
                    <td><T k={labelKey} /></td>
                    <td>
                      {value === null || value === undefined
                        ? <span class="badge unknown"><T k="badge.unknown" /></span>
                        : <span>{display(value)} {isOfficial && <span class="badge official"><T k="providers.detail.officialFact" /></span>}</span>}
                    </td>
                    <td>{entry && entry.source ? <a href={entry.source} rel="noopener"><T k="providers.detail.source" /></a> : "—"}</td>
                    <td class="mono">{entry ? when(entry.checked_at) : "—"}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </>
    ))
  ) : <div class="empty"><T k="providers.detail.noPrivacy" /></div>}
  <p class="small muted">
    <T k="providers.detail.privacyNote" />
  </p>

  <h2><T k="providers.detail.reliability" /></h2>
  <p class="small">
    <T k="providers.detail.reliabilityNote" vars={{ benchmarks: benchmarks.length, community: community.length, reliability: href("reliability/") }} />
  </p>

  <h2><T k="providers.detail.dataSources" /></h2>
  {sources.length ? (
    <ul class="plain">
      {sources.map((entry) => (
        <li>
          <span class="badge">{display(entry.type)}</span>{" "}
          {entry.url ? <a href={entry.url} rel="noopener">{display(entry.id)}</a> : display(entry.id)}
          <span class="muted small"> — {display(entry.used_for)}<T k="providers.detail.checkedInline" />{when(entry.checked_at)}</span>
        </li>
      ))}
    </ul>
  ) : <div class="empty"><T k="providers.detail.noSources" /></div>}
</Base>
